      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 731297902,
      "version": 1,
      "versionNonce": 144838056,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The app never sees a password. Roles come from the IdP's groups through role_mappings, checked on every request.\nLogout deletes the app session and ends the IdP session, so the next login asks for the password again.",
      "originalText": "The app never sees a password. Roles come from the IdP's groups through role_mappings, checked on every request.\nLogout deletes the app session and ends the IdP session, so the next login asks for the password again.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
