      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Refused: a state this app did not issue, a callback replayed, a token minted for another client or login,\nreturnTo pointing off the app (open redirect); a signed-in user with no mapped role gets 403",
      "originalText": "Refused: a state this app did not issue, a callback replayed, a token minted for another client or login,\nreturnTo pointing off the app (open redirect); a signed-in user with no mapped role gets 403",
