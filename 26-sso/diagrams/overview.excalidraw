      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t9",
      "type": "text",
      "x": 40,
      "y": 660,
      "width": 896,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
