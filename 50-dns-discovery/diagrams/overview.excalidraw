      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "DNS knows names, not health: a stopped replica leaves DNS at once, a hung one stays until a timeout finds it.\nCaches and keep-alive connections decide when a client sees a change; a short timeout and a retry on another address cover the gap.",
      "originalText": "DNS knows names, not health: a stopped replica leaves DNS at once, a hung one stays until a timeout finds it.\nCaches and keep-alive connections decide when a client sees a change; a short timeout and a retry on another address cover the gap.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
