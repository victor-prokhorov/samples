{
  "name": "33-api-contract",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "redocly lint openapi/v1.yaml openapi/v2.yaml openapi/v2-breaking.yaml --format=stylish",
    "generate": "openapi-typescript openapi/v2.yaml -o src/generated/api.d.ts",
    "docs": "tsx src/docs.ts",
    "server": "tsx src/server.ts",
    "contract": "vitest run",
    "breaking": "tsx src/breaking.ts",
    "demo": "tsx src/demo.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "openapi-fetch": "^0.17.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@redocly/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.13.0",
    "redoc": "^2.5.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
