       proname        | security_definer |                                                                                                body                                                                                                
----------------------+------------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 can_read_member_data | f                |  SELECT CASE app_role() WHEN 'member' THEN rel(target) = 'own record' WHEN 'employer_admin' THEN rel(target) = 'same organisation' WHEN 'staff' THEN true WHEN 'auditor' THEN true ELSE false END 
 rel                  | t                |  SELECT CASE WHEN target = app_member() THEN 'own record' WHEN (SELECT org_id FROM members WHERE id = target) = app_org() THEN 'same organisation' ELSE 'other organisation' END 
