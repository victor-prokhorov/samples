## 5. A scheduled pipeline deploys
   concept: the deploy job needs build (it downloads dist/ from it), runs in the production environment, one at a time (resource_group), and switches a symlink so the release goes live atomically
   deploy    $ RELEASE="${CI_COMMIT_TAG:-scheduled-$CI_COMMIT_SHORT_SHA-$CI_PIPELINE_ID}"
   deploy    $ mkdir -p "$DEPLOY_DIR/releases/$RELEASE"
   deploy    $ cp -r dist/. "$DEPLOY_DIR/releases/$RELEASE/"
   deploy    $ echo '{"type":"module"}' > "$DEPLOY_DIR/releases/$RELEASE/package.json"
   deploy    $ printf '{"release":"%s","commit":"%s","source":"%s"}\n' "$RELEASE" "$CI_COMMIT_SHA" "$CI_PIPELINE_SOURCE" > "$DEPLOY_DIR/releases/$RELEASE/release.json"
   deploy    $ ln -sfn "releases/$RELEASE" "$DEPLOY_DIR/current.tmp" && mv -T "$DEPLOY_DIR/current.tmp" "$DEPLOY_DIR/current"
   deploy    $ node -e "import('$DEPLOY_DIR/current/page.js').then((m) => { if (!m.statementPage('smoke', 2026, []).includes('<html lang=\"en\">')) process.exit(1); console.log('smoke ok') })"
   deploy    > smoke ok
   deploy    $ echo "deployed $RELEASE to $DEPLOY_DIR/current"
   deploy    > deployed scheduled-297ddab1-1002 to .deploy/current
