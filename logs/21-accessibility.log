== proof: the inaccessible form after a failed submit (out/bad-errors.html): placeholders, a red class, a div for a button ==
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Form</title>
</head>
<body>
<div class="title">Change your address</div>
<div class="hint">We will send a confirmation letter to the new address.</div>
<form action="/bad" method="post">
<input type="text" placeholder="Address line 1" class="err" name="line1" value="">
<input type="text" placeholder="Town or city" class="err" name="city" value="">
<input type="text" placeholder="Postcode" class="err" name="postcode" value="">
<input type="text" placeholder="Country" class="err" name="country" value="">
<div class="hint err">Apply from</div>
<input type="radio" name="when" value="today"> Today<input type="radio" name="when" value="next-statement"> Next statement<div>
<div class="btn" id="save">Save</div>
</div>
</form>
<script>document.getElementById('save').addEventListener('click', () => document.forms[0].submit())</script>
</body>
</html>
== proof: the accessible form after a failed submit (out/good-errors.html): summary, labels, aria-describedby, aria-invalid, autocomplete ==
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Error: Change your address - Member portal</title>
</head>
<body>
<main>
<div id="error-summary" tabindex="-1" aria-labelledby="error-summary-title" role="alert">
<h2 id="error-summary-title">There is a problem</h2>
<ul>
<li>
<a href="#line1">Enter the first line of your address</a>
</li>
<li>
<a href="#city">Enter your town or city</a>
</li>
<li>
<a href="#postcode">Enter your postcode</a>
</li>
<li>
<a href="#country">Enter your country</a>
</li>
<li>
<a href="#when-today">Select when the change should apply</a>
</li>
</ul>
</div>
<h1>Change your address</h1>
<p class="hint">We will send a confirmation letter to the new address.</p>
<form novalidate="" action="/good" method="post">
<fieldset>
<legend>New address</legend>
<div class="field-error">
<label for="line1">Address line 1</label>
<p id="line1-error" class="error">
<span class="visually-hidden">Error: </span>Enter the first line of your address</p>
<input type="text" id="line1" autocomplete="address-line1" aria-invalid="true" aria-describedby="line1-error" name="line1" value="">
</div>
<div class="field-error">
<label for="city">Town or city</label>
<p id="city-error" class="error">
<span class="visually-hidden">Error: </span>Enter your town or city</p>
<input type="text" id="city" autocomplete="address-level2" aria-invalid="true" aria-describedby="city-error" name="city" value="">
</div>
<div class="field-error">
<label for="postcode">Postcode</label>
<p id="postcode-hint" class="hint">For example, AB1 2CD</p>
<p id="postcode-error" class="error">
<span class="visually-hidden">Error: </span>Enter your postcode</p>
<input type="text" id="postcode" autocomplete="postal-code" aria-invalid="true" aria-describedby="postcode-hint postcode-error" name="postcode" value="">
</div>
<div class="field-error">
<label for="country">Country</label>
<p id="country-error" class="error">
<span class="visually-hidden">Error: </span>Enter your country</p>
<input type="text" id="country" autocomplete="country-name" aria-invalid="true" aria-describedby="country-error" name="country" value="">
</div>
</fieldset>
<fieldset class="field-error" aria-describedby="when-error">
<legend>When should the change apply?</legend>
<p id="when-error" class="error">
<span class="visually-hidden">Error: </span>Select when the change should apply</p>
<div class="radio">
<input type="radio" id="when-today" name="when" value="today">
<label for="when-today">From today</label>
</div>
<div class="radio">
<input type="radio" id="when-next-statement" name="when" value="next-statement">
<label for="when-next-statement">From the next annual statement</label>
</div>
</fieldset>
<button type="submit">Save new address</button>
</form>
</main>
<script>document.getElementById('error-summary')?.focus()</script>
</body>
</html>
