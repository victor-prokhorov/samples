{
  "name": "samples",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "remoteUser": "node",
  "containerEnv": { "PLAYWRIGHT_BROWSERS_PATH": "/opt/pw-browsers" },
  "postCreateCommand": "cd tools && npm ci --no-audit --no-fund",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "ms-playwright.playwright", "bierner.markdown-mermaid"]
    }
  }
}
