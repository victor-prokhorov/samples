{
  "$description": "Semantic colours, dark mode. Same names as theme.light.tokens.json, different primitives.",
  "color": {
    "$type": "color",
    "bg": {
      "canvas": { "$value": "{color.gray.950}", "$description": "Page background." },
      "surface": { "$value": "{color.gray.900}", "$description": "Cards, inputs, secondary buttons." },
      "subtle": { "$value": "{color.gray.800}", "$description": "Card footers, table stripes." },
      "accent": { "$value": "{color.blue.300}", "$description": "Primary button." },
      "accent-hover": { "$value": "{color.blue.200}" },
      "danger": { "$value": "{color.red.300}", "$description": "Destructive button." },
      "danger-hover": { "$value": "{color.red.100}" },
      "info-subtle": { "$value": "{color.blue.900}" },
      "success-subtle": { "$value": "{color.green.900}" },
      "warning-subtle": { "$value": "{color.amber.900}" },
      "danger-subtle": { "$value": "{color.red.900}" }
    },
    "text": {
      "default": { "$value": "{color.gray.50}" },
      "muted": { "$value": "{color.gray.400}", "$description": "Hints, metadata. Still body text: 4.5:1." },
      "on-accent": { "$value": "{color.gray.950}", "$description": "Text on accent and danger buttons." },
      "link": { "$value": "{color.blue.300}" },
      "info": { "$value": "{color.blue.200}" },
      "success": { "$value": "{color.green.300}" },
      "warning": { "$value": "{color.amber.300}" },
      "danger": { "$value": "{color.red.300}", "$description": "Error messages and danger alert titles." }
    },
    "border": {
      "default": { "$value": "{color.gray.700}", "$description": "Dividers. Decorative: no contrast requirement." },
      "input": { "$value": "{color.gray.400}", "$description": "Input and secondary button outline: identifies the control (1.4.11)." },
      "focus": { "$value": "{color.blue.300}" },
      "danger": { "$value": "{color.red.300}" },
      "info": { "$value": "{color.blue.400}" },
      "success": { "$value": "{color.green.300}" },
      "warning": { "$value": "{color.amber.300}" }
    }
  }
}
