      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A visible label on every input, never a placeholder only\nErrors in text, tied to the field with aria-describedby; an error summary that takes focus\nEverything reachable and submittable with the keyboard\nlang on the page, and on parts in the other language\nReflow at 320 px wide without horizontal scrolling; text at 200%\nTargets at least 24 px, text contrast at least 4.5:1\nSign-in without a memory test: paste and password managers allowed",
      "originalText": "A visible label on every input, never a placeholder only\nErrors in text, tied to the field with aria-describedby; an error summary that takes focus\nEverything reachable and submittable with the keyboard\nlang on the page, and on parts in the other language\nReflow at 320 px wide without horizontal scrolling; text at 200%\nTargets at least 24 px, text contrast at least 4.5:1\nSign-in without a memory test: paste and password managers allowed",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "c1",
      "lineHeight": 1.25,
      "autoResize": true
